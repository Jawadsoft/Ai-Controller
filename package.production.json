{
  "name": "daive-production",
  "version": "1.0.0",
  "type": "module",
  "description": "Production build of DAIVE vehicle management system",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "NODE_ENV=production node src/server.js",
    "start:pm2": "pm2 start ecosystem.config.js --env production",
    "stop:pm2": "pm2 stop daive-backend",
    "restart:pm2": "pm2 restart daive-backend",
    "reload:pm2": "pm2 reload daive-backend",
    "status:pm2": "pm2 status daive-backend",
    "logs:pm2": "pm2 logs daive-backend",
    "monitor:pm2": "pm2 monit",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "vite build",
    "build:backend": "echo 'Backend is ready for production'",
    "build:production": "npm ci --only=production && npm run build:frontend",
    "deploy:build": "npm run build:production && npm run package:production",
    "package:production": "mkdir -p dist && cp -r src dist/ && cp package*.json dist/ && cp ecosystem.config.js dist/ && cp -r uploads dist/ 2>/dev/null || true",
    "deploy:local": "npm run deploy:build",
    "deploy:server": "npm run deploy:build && rsync -avz --delete dist/ deploy@your-server:/var/www/daive-production/",
    "health:check": "curl -f http://localhost:3000/api/daive/crew-ai-settings?dealerId=test || echo 'Health check failed'",
    "db:migrate": "node src/database/migrate.js",
    "db:backup": "pg_dump $DATABASE_URL > backup_$(date +%Y%m%d_%H%M%S).sql",
    "logs:rotate": "pm2 flush && pm2 reloadLogs",
    "cleanup": "rm -rf dist node_modules package-lock.json",
    "install:prod": "npm ci --only=production",
    "install:dev": "npm install",
    "update:pm2": "pm2 update",
    "save:pm2": "pm2 save",
    "startup:pm2": "pm2 startup"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "crewai": "^1.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "openai": "^4.28.0",
    "pg": "^8.11.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "pm2": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "keywords": [
    "daive",
    "vehicle-management",
    "ai",
    "crewai",
    "production",
    "deployment"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "your-repository-url"
  }
}

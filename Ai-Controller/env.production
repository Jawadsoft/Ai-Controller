# Production Environment Configuration for Render.com
NODE_ENV=production
PORT=10000

# Database Configuration (will be set by Render.com)
DATABASE_URL=${DATABASE_URL}

# JWT Secret (set this in Render.com environment variables)
JWT_SECRET=${JWT_SECRET}

# API Keys (set these in Render.com environment variables)
OPENAI_API_KEY=${OPENAI_API_KEY}
DEEPGRAM_API_KEY=${DEEPGRAM_API_KEY}

# Frontend and Backend URLs for production
FRONTEND_URL=https://app.dealeriq.co
BACKEND_URL=https://vehicle-management-backend-ypsa.onrender.com

# CORS Configuration
CORS_ORIGIN=https://app.dealeriq.co

# SSL Configuration for Production
SSL_MODE=require

# Rate limiting for production
RATE_LIMIT_ENABLED=true
